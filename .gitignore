/target
/.gpg/
/prototype/hillclimb/decision.tsv
/prototype/hillclimb/scores.json
/prototype/hillclimb/baseline.json
/.ds-ledger.tsv
# This host's global excludes file has `lock*`, which silently drops src/lock.rs
# from `git add`; a repo rule outranks it and a clean clone then still builds.
!src/lock.rs
# Per-run scenario logs, written by sim/run.sh.
/sim-logs

# Factory runtime state (tickets, ledger, inbox) is machine-local, not product.
# The mandate lives here, not in a commit: the gate reads it with --ticket-file.
/.factory/inbox/
/.factory/ledger.jsonl
/.factory/guard.log
/.factory/gates/last-gate.json
/.factory/tickets/
/.factory/state.md
